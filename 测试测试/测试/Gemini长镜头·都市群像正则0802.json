    {
      "id": "rule_1785625094930_bhfh",
      "scriptName": "暗黑场记状态栏",
      "findRegex": "/<status>([\\s\\S]*?)<\\/status>\\s*/g",
      "replaceString": "```html\n<!DOCTYPE html><html lang=\"zh-CN\"><head><style>body{margin:0;padding:15px 5px 20px 5px;background:transparent;} .wrap{display:flex;flex-direction:column;gap:10px;} .accent{width:32px;height:6px;background:#111;margin-bottom:-2px;} .loc{font-size:20px;font-weight:bold;color:#111;letter-spacing:2px;line-height:1.4;} .meta{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:2px;} .t-dark{background:#111;color:#fff;padding:4px 10px;font-size:11px;letter-spacing:1px;border-radius:2px;} .t-light{font-size:12px;color:#555;letter-spacing:1px;} .quote{font-size:13px;color:#333;line-height:1.7;text-align:justify;padding-left:14px;border-left:3px solid #e5e5e5;margin-top:4px;}</style></head><body><textarea id=\"raw\" style=\"display:none;\">$1</textarea><div id=\"app\"></div><script>let lines=document.getElementById('raw').value.trim().split(/\\r?\\n/).filter(l=>l.trim()&&!l.startsWith('<'));let t_time='',t_loc='',t_quote='',t_chars='';lines.forEach(l=>{let idx=l.search(/[:：]/);let k=idx>-1?l.substring(0,idx).trim():'';let v=idx>-1?l.substring(idx+1).trim():l.trim();if(/时间|日期/.test(k)) t_time=v;else if(/位置|地点|场景/.test(k)) t_loc=v;else if(/在场|人物/.test(k)) t_chars=v;else if(/内心|独白|想法|OS/.test(k)) t_quote=v;else if(!t_loc) t_loc=v;});let html='<div class=\"wrap\"><div class=\"accent\"></div><div class=\"loc\">'+t_loc+'</div><div class=\"meta\">';if(t_time) html+='<div class=\"t-dark\">'+t_time+'</div>';if(t_chars) html+='<div class=\"t-light\">在场：'+t_chars+'</div>';html+='</div>';if(t_quote) html+='<div class=\"quote\">'+t_quote+'</div>';html+='</div>';document.getElementById('app').innerHTML=html;</script></body></html>\n```",
