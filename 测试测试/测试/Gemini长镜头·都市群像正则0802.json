      "id": "rule_1785623707053_kq06",
      "scriptName": "论坛弹幕气泡",
      "findRegex": "/<forum>([\\s\\S]*?)<\\/forum>\\s*/g",
      "replaceString": "\n<!--RHR-FOLD:forum-->\n```html\n<!DOCTYPE html><html lang=\"zh-CN\"><head><style>body{margin:0;padding:10px 0;background:transparent;font-family:\"Songti SC\",\"STSong\",\"Source Han Serif SC\",\"Noto Serif SC\",serif;} .card{background:transparent;} .mast{display:flex;justify-content:space-between;align-items:baseline;border-bottom:1px solid #111;padding-bottom:8px;} .chip{background:#111;color:#fff;font-family:Georgia,\"Times New Roman\",serif;font-style:italic;font-size:9px;letter-spacing:2px;padding:2px 8px;} .mast-r{font-family:Georgia,\"Times New Roman\",serif;font-style:italic;font-size:13px;color:#777;} .comment{display:flex;gap:12px;padding:12px 2px;border-bottom:1px solid #f0f0f0;} .comment:last-child{border-bottom:none;} .floor{flex:0 0 26px;font-family:Georgia,\"Times New Roman\",serif;font-style:italic;font-size:12px;color:#bfbfbf;text-align:right;padding-top:3px;} .body{flex:1;font-size:12.5px;line-height:1.9;color:#333;text-align:justify;} .user{color:#111;font-weight:700;font-size:11px;letter-spacing:1px;margin-right:8px;}</style></head><body><textarea id=\"raw\" style=\"display:none;\">$1</textarea><div class=\"card\"><div class=\"mast\"><span class=\"chip\">BBS</span><span class=\"mast-r\">Public Forum</span></div><div id=\"app\"></div></div><script>let lines=document.getElementById('raw').value.trim().split(/\\r?\\n/).filter(l=>l.trim()&&!l.startsWith('<'));document.getElementById('app').innerHTML=lines.map(l=>{let m=l.match(/^(.*?L\\s*[^：:]*)[：:](.*)$/);if(m){let head=m[1].trim();let fm=head.match(/^(\\d+\\s*L)\\s*(.*)$/i);let fl=fm?fm[1].replace(/\\s+/g,''):'';let un=fm?fm[2]:head;return `<div class=\"comment\"><div class=\"floor\">${fl}</div><div class=\"body\"><span class=\"user\">${un}</span>${m[2].trim()}</div></div>`;}return `<div class=\"comment\"><div class=\"floor\"></div><div class=\"body\">${l}</div></div>`;}).join('');</script></body></html>\n```\n<!--/RHR-FOLD-->\n",
