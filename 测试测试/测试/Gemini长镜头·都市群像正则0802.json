      "scriptName": "群像Tab交互卡片",
      "findRegex": "/<loom>([\\s\\S]*?)<\\/loom>\\s*/g",
      "replaceString": "\n<!--RHR-FOLD:theater-->\n```html\n<!DOCTYPE html><html lang=\"zh-CN\"><head><style>body{margin:0;padding:12px 0;background:transparent;font-family:\"Songti SC\",\"STSong\",\"Source Han Serif SC\",\"Noto Serif SC\",serif;} .card{background:transparent;text-align:center;} .orn{font-size:9px;color:#111;margin-bottom:10px;} .h-main{font-size:13px;font-weight:700;color:#111;letter-spacing:6px;text-transform:uppercase;} .h-sub{font-family:Georgia,\"Times New Roman\",serif;font-style:italic;font-size:11px;color:#999;margin-top:5px;letter-spacing:1px;} .tabs{display:flex;justify-content:center;gap:22px;overflow-x:auto;scrollbar-width:none;margin-top:16px;padding-bottom:9px;border-bottom:3px double #c9c9c9;} .tabs::-webkit-scrollbar{display:none;} .tab{font-size:12px;color:#999;cursor:pointer;letter-spacing:2px;white-space:nowrap;padding:0 2px 2px;transition:color 0.3s;} .tab.active{color:#111;font-weight:700;box-shadow:0 2px 0 #111;} .content{display:none;padding:16px 2px 4px;animation:fadeIn 0.5s ease;text-align:left;} .content.active{display:block;} @keyframes fadeIn{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:translateY(0);}} .loc{text-align:center;font-size:10px;color:#8a8a8a;letter-spacing:3px;margin-bottom:12px;} .loc::before{content:'\\300c\\2002';color:#bbb;} .loc::after{content:'\\2002\\300d';color:#bbb;} .text{font-size:13px;line-height:2;color:#333;text-align:justify;}</style></head><body><textarea id=\"raw\" style=\"display:none;\">$1</textarea><div class=\"card\"><div class=\"orn\">&#9670;</div><div class=\"h-main\">Ensemble Cast</div><div class=\"h-sub\">scene focus</div><div id=\"app\"></div></div><script>let r=document.getElementById('raw').value.replace(/<\\/?cut>/gi,'');let p=r.split(/【([^·]+?)·([^】]+?)】/);let t='',c='',v=0;for(let i=1;i<p.length;i+=3){let n=p[i].trim(),l=p[i+1].trim(),txt=p[i+2].trim().replace(/\\n/g,'<br><br>');let a=v===0?'active':'';t+=`<div class=\"tab ${a}\" onclick=\"s(${v})\">${n}</div>`;c+=`<div class=\"content ${a}\" id=\"c${v}\"><div class=\"loc\">${l}</div><div class=\"text\">${txt}</div></div>`;v++;}document.getElementById('app').innerHTML=`<div class=\"tabs\">${t}</div><div>${c}</div>`;window.s=function(idx){document.querySelectorAll('.tab').forEach((e,i)=>e.className=i===idx?'tab active':'tab');document.querySelectorAll('.content').forEach((e,i)=>e.className=i===idx?'content active':'content');}</script></body></html>\n```\n<!--/RHR-FOLD-->\n",
