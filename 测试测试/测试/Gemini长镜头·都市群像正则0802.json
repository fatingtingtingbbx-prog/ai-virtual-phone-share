    {
      "id": "rule_1785624955430_iyp4",
      "scriptName": "暗黑选项卡片",
      "findRegex": "/<options>([\\s\\S]*?)<\\/options>\\s*/g",
      "replaceString": "\n<!--RHR-FOLD:options-->\n```html\n<!DOCTYPE html><html lang=\"zh-CN\"><head><style>body{margin:0;padding:10px 0;background:transparent;font-family:\"Songti SC\",\"STSong\",\"Source Han Serif SC\",\"Noto Serif SC\",serif;} .card{background:transparent;} .header{font-size:10px;color:#999;letter-spacing:4px;text-transform:uppercase;margin-bottom:8px;display:flex;align-items:center;} .header::before{content:'';display:inline-block;width:7px;height:7px;background:#111;margin-right:9px;} .item{display:flex;align-items:flex-start;gap:14px;padding:10px 2px;cursor:pointer;transition:background 0.2s;} .item:active{background:#f2f2f2;} .gnum{flex:0 0 36px;font-family:Georgia,\"Times New Roman\",serif;font-style:italic;font-weight:700;font-size:26px;line-height:1;color:#e0e0e0;text-align:right;} .txt{flex:1;font-size:12.5px;line-height:1.9;color:#333;text-align:justify;padding-top:4px;}</style></head><body><textarea id=\"raw\" style=\"display:none;\">$1</textarea><div class=\"card\"><div class=\"header\">Decision Point</div><div id=\"app\"></div></div><script>let lines=document.getElementById('raw').value.trim().split(/\\r?\\n/).filter(l=>l.trim());document.getElementById('app').innerHTML=lines.map((l,i)=>{let c=l.trim().replace(/^\\d+\\s*[.、).：:]\\s*/,'');let n=(i+1).toString().padStart(2,'0');let plain=c.replace(/<[^>]*>/g,'').replace(/&quot;/g,'\"').replace(/&amp;/g,'&').trim();let a=plain.replace(/&/g,'&amp;').replace(/\"/g,'&quot;');return `<div class=\"item\" data-action=\"${a}\"><div class=\"gnum\">${n}</div><div class=\"txt\">${c}</div></div>`;}).join('');</script></body></html>\n```\n<!--/RHR-FOLD-->\n",
