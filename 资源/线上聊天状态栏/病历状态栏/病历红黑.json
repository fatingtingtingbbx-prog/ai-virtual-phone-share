{
  "type": "ai-phone-status-region",
  "version": 1,
  "contract": "【状态栏】\n【逻辑】\n在每轮回复的最末尾，根据当前聊天上下文、剧情进展以及角色对用户的隐秘心理，生成精神病院监护病历数据。\n必须严格遵循以下原则：\n1. 【受试对象】必须填入角色自身的名字。\n2. 【用户称谓】严禁直接输出英文词\"user\"或\"USER\"，必须替换为当前与你对话的用户真实名字（或你对Ta的特定称呼）。\n3. 【双层文风——欧美精神病院恐怖片风格】\n   - 医疗层（diagnosis, pulseReason, obsessionDesc, restraintReason, symptoms, doctorNote）：官僚式的冷漠。像一个对病患毫无感情的机构职员在填表格，用编号称呼受试者，语气敷衍、例行公事、去人性化。偶尔流露出对受试者的厌烦或不耐。\n   - 角色层（scratchNote）：像用指甲刻在墙上的字。句子破碎、重复、执念外露。比物哀版更生猛、更赤裸，但不是嘶吼——是那种在黑暗里反复低声念叨同一件事的疯狂。短句，断裂感。\n4. 必须整块使用 [状态栏] 与 [/状态栏] 标签包裹，不得在正文中提及，不得添加代码块反引号标记。\n\n【格式】\n[状态栏]\n{\n  \"fileNo\": \"<病历编号，如 CASE-0173>\",\n  \"patientName\": \"<角色自身全名>\",\n  \"threatLevel\": \"<收容等级，如 CODE RED / HIGH RISK>\",\n  \"diagnosis\": \"<简短诊断，官僚语气，如 重度妄想性依附，拒绝配合治疗>\",\n  \"sanVal\": <0-100整数>,\n  \"pulseVal\": \"<如 132 BPM>\",\n  \"pulseReason\": \"<敷衍的诱因记录，如 探视名单里出现了{{user}}的名字>\",\n  \"obsessionVal\": \"<如 99.9%>\",\n  \"obsessionDesc\": \"<简短状态，如 不可控>\",\n  \"restraintPhase\": \"<如 LEVEL 3>\",\n  \"restraintReason\": \"<例行记录语气，如 咬伤护工，要求见{{user}}>\",\n  \"symptoms\": [\"<短句症状1>\", \"<短句症状2>\", \"<短句症状3>\"],\n  \"doctorNote\": \"<机构职员式的记录，用用户的名字，敷衍、冷漠、去人性化，40-70字>\",\n  \"scratchNote\": \"<角色的墙壁刻痕/涂写，用用户的名字，破碎、重复、低声念叨式的疯狂，40-70字>\"\n}\n[/状态栏]",
  "renderHtml": "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<style>\n  * { box-sizing: border-box; margin: 0; padding: 0; }\n  \n  :root {\n    /* 精神病院——荧光灯下的腐败机构 */\n    --base-dark: #0c0f0d;\n    --base-card: rgba(18, 23, 20, 0.78);\n    --mist-edge: 0 0 16px rgba(0,0,0,0.9), inset 0 0 18px rgba(12,15,13,0.92), inset 0 0 5px rgba(120,135,115,0.02);\n\n    /* 荧光灯映照下的病态绿灰 */\n    --t-bright: #c5c4b8;\n    --t-main: #7e8478;\n    --t-sub: #4f5549;\n\n    /* 机构标识——沉闷的暗红，不是棕 */\n    --t-stamp: #6e3538;\n\n    /* 角色刻痕——暗血红，沉在阴影里的红 */\n    --t-scratch: #8c3e3e;\n  }\n\n  body {\n    background: transparent;\n    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'SF Pro Text', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;\n    color: var(--t-main);\n    font-size: 12px;\n    line-height: 1.5;\n    padding: 4px;\n    -webkit-text-size-adjust: 100%;\n  }\n\n  .mono { font-family: 'Courier New', Courier, monospace; }\n\n  .record-wrapper {\n    background: var(--base-dark);\n    background-image: radial-gradient(ellipse at 30% 0%, #141a16 0%, #080a09 100%);\n    border-left: 3px solid var(--t-stamp);\n    border-radius: 0 !important;\n    padding: 14px 14px;\n    box-shadow: 0 10px 35px rgba(0,0,0,0.93), inset 0 0 50px rgba(0,0,0,0.85);\n    position: relative;\n    overflow: hidden;\n  }\n\n  .glow-a {\n    position: absolute; width: 250px; height: 100px; top: -30px; left: 50%; transform: translateX(-50%);\n    background: radial-gradient(ellipse, rgba(180,185,160,0.035) 0%, transparent 70%);\n    filter: blur(25px); pointer-events: none;\n  }\n  .glow-b {\n    position: absolute; width: 150px; height: 150px; bottom: -50px; right: -30px;\n    background: radial-gradient(circle, rgba(140,62,62,0.04) 0%, transparent 70%);\n    filter: blur(30px); pointer-events: none;\n  }\n\n  .watermark {\n    position: absolute; right: 8px; bottom: 4px;\n    font-size: 18px; font-weight: 900;\n    color: rgba(110,53,56,0.03);\n    letter-spacing: 4px; pointer-events: none; user-select: none;\n    font-family: 'Courier New', monospace;\n    text-transform: uppercase;\n  }\n\n  .feather-panel {\n    background: var(--base-card);\n    border-radius: 0 !important; border: none;\n    box-shadow: var(--mist-edge);\n    position: relative;\n  }\n\n  .header-card { padding: 11px 13px; margin-bottom: 10px; }\n  .header-top-row {\n    display: flex; justify-content: space-between; align-items: center;\n    border-bottom: 1px solid rgba(110,53,56,0.12);\n    padding-bottom: 6px; margin-bottom: 8px;\n  }\n  .header-code { font-size: 10px; color: var(--t-sub); letter-spacing: 0.5px; }\n  .header-badge {\n    color: var(--t-scratch); background: rgba(110,53,56,0.1);\n    border: 1px solid rgba(110,53,56,0.25);\n    padding: 1px 7px; font-size: 10px; font-weight: 700;\n    letter-spacing: 1px; white-space: nowrap; border-radius: 0 !important;\n  }\n  .header-main-title {\n    font-size: 14px; font-weight: 800; letter-spacing: 1px;\n    color: var(--t-bright); margin-bottom: 6px;\n  }\n\n  .diagnosis-bar {\n    display: flex; align-items: center; gap: 6px;\n    background: rgba(79,85,73,0.08);\n    border-left: 2px solid rgba(110,53,56,0.3);\n    padding: 5px 8px; font-size: 11px;\n    box-shadow: inset 0 0 12px rgba(0,0,0,0.4);\n  }\n  .diagnosis-tag { font-size: 10px; font-weight: 700; color: var(--t-stamp); white-space: nowrap; letter-spacing: 0.5px; }\n  .diagnosis-text { color: var(--t-main); font-weight: 500; line-height: 1.35; word-break: break-all; }\n\n  .patient-bar {\n    display: flex; justify-content: space-between; align-items: center;\n    padding: 8px 13px; margin-bottom: 10px; font-size: 12px;\n  }\n  .patient-lbl { color: var(--t-sub); font-size: 11px; letter-spacing: 0.5px; white-space: nowrap; }\n  .patient-name-val { color: var(--t-bright); font-weight: 800; letter-spacing: 1.2px; font-size: 13px; white-space: nowrap; }\n\n  .metrics-unified-block { margin-bottom: 10px; display: flex; flex-direction: column; }\n  .metrics-val-row { display: grid; grid-template-columns: 1fr 1fr; }\n  .metric-col-val { padding: 9px 12px 6px 12px; display: flex; flex-direction: column; }\n  .metric-col-val:first-child { border-right: 1px solid rgba(120,135,115,0.06); }\n  .metric-label { font-size: 10.5px; color: var(--t-sub); margin-bottom: 2px; white-space: nowrap; }\n  .metric-num { font-size: 14.5px; font-weight: 800; color: var(--t-bright); line-height: 1.2; white-space: nowrap; }\n\n  .metrics-divider-line {\n    height: 1px;\n    background: linear-gradient(90deg, transparent, rgba(120,135,115,0.07) 20%, rgba(120,135,115,0.07) 80%, transparent);\n    width: 100%;\n  }\n\n  .metrics-desc-row { display: grid; grid-template-columns: 1fr 1fr; }\n  .metric-col-desc { padding: 6px 12px 9px 12px; font-size: 10px; color: var(--t-main); line-height: 1.4; word-break: break-all; }\n  .metric-col-desc:first-child { border-right: 1px solid rgba(120,135,115,0.06); }\n\n  .restraint-card { padding: 8px 13px; margin-bottom: 10px; display: flex; flex-direction: column; }\n  .restraint-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }\n  .restraint-desc { font-size: 10px; color: var(--t-main); line-height: 1.4; border-top: 1px solid rgba(120,135,115,0.06); padding-top: 5px; word-break: break-all; }\n\n  .san-section { margin-bottom: 10px; padding: 8px 13px; }\n  .san-header { display: flex; justify-content: space-between; align-items: center; font-size: 11px; margin-bottom: 6px; font-weight: 600; }\n  .san-title-text { white-space: nowrap; color: var(--t-sub); }\n  .san-val-text { white-space: nowrap; color: var(--t-bright); }\n  .san-track { height: 3px; background: #080a09; border-radius: 0 !important; width: 100%; overflow: hidden; box-shadow: inset 0 1px 2px rgba(0,0,0,0.8); }\n  .san-bar { height: 100%; border-radius: 0 !important; background: linear-gradient(90deg, #1a1c1a, var(--t-stamp)); box-shadow: 0 0 6px rgba(110,53,56,0.3); transition: width 0.4s ease; }\n\n  .symptoms-box { display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px; }\n  .symptom-item { font-size: 11px; color: var(--t-main); padding: 6px 12px; display: flex; align-items: flex-start; gap: 6px; line-height: 1.4; }\n  .symptom-dot { color: var(--t-stamp); font-size: 11px; line-height: 1.4; flex-shrink: 0; opacity: 0.6; }\n\n  .log-section { padding: 10px 13px; }\n  .log-title { font-size: 10px; font-weight: 700; color: var(--t-sub); letter-spacing: 1px; margin-bottom: 6px; text-transform: uppercase; white-space: nowrap; }\n  .doctor-note { font-size: 11.5px; color: var(--t-main); line-height: 1.65; margin-bottom: 10px; }\n\n  .scratch-note {\n    border-top: 1px solid rgba(140,62,62,0.1);\n    padding-top: 9px;\n    font-size: 11.5px;\n    color: var(--t-scratch);\n    line-height: 1.7;\n    font-style: normal;\n    font-weight: 600;\n    letter-spacing: 0.3px;\n    text-shadow: 0 0 8px rgba(140,62,62,0.18);\n    opacity: 0.9;\n  }\n</style>\n</head>\n<body>\n<div class=\"record-wrapper\">\n  <div class=\"glow-a\"></div>\n  <div class=\"glow-b\"></div>\n  <div class=\"watermark\">CLASSIFIED</div>\n  <div id=\"app\"></div>\n</div>\n\n<script>\n  function parseData() {\n    let raw = window.STATUS_RAW || '';\n    const match = raw.match(/\\[状态栏\\]([\\s\\S]*?)\\[\\/状态栏\\]/);\n    if (match) raw = match[1];\n    const jsonMatch = raw.match(/\\{[\\s\\S]*\\}/);\n    if (jsonMatch) { try { return JSON.parse(jsonMatch[0]); } catch(e) {} }\n    return null;\n  }\n\n  function render() {\n    const data = parseData();\n    if (!data) {\n      document.getElementById('app').innerHTML = '<div style=\"padding:16px;color:#4f5549;text-align:center;font-size:11px;\">[ NO ACTIVE CASE FILE ]</div>';\n      return;\n    }\n\n    const san = Math.max(0, Math.min(100, Number(data.sanVal) || 0));\n    const symptomsHtml = (data.symptoms || []).map(s => `\n      <div class=\"symptom-item feather-panel\"><span class=\"symptom-dot\">■</span><span>${s}</span></div>\n    `).join('');\n\n    let threatCode = data.threatLevel || 'CODE RED';\n    let diagnosis = data.diagnosis || '重度妄想性依附';\n    const obsessionVal = data.obsessionVal || '99%';\n    const obsessionDesc = data.obsessionDesc || '';\n    const pulseVal = data.pulseVal || '--';\n    const pulseReason = data.pulseReason || '';\n    const restraintPhase = data.restraintPhase || 'LEVEL 0';\n    const restraintReason = data.restraintReason || '';\n\n    document.getElementById('app').innerHTML = `\n      <div class=\"header-card feather-panel\">\n        <div class=\"header-top-row\">\n          <span class=\"header-code mono\">FILE // ${data.fileNo || 'CASE-0173'}</span>\n          <span class=\"header-badge mono\">${threatCode}</span>\n        </div>\n        <div class=\"header-main-title\">精神科强制收容档案</div>\n        <div class=\"diagnosis-bar\">\n          <span class=\"diagnosis-tag mono\">[DIAGNOSIS]</span>\n          <span class=\"diagnosis-text\">${diagnosis}</span>\n        </div>\n      </div>\n\n      <div class=\"patient-bar feather-panel\">\n        <span class=\"patient-lbl\">收容对象 (PATIENT)</span>\n        <span class=\"patient-name-val\">${data.patientName || '--'}</span>\n      </div>\n\n      <div class=\"metrics-unified-block feather-panel\">\n        <div class=\"metrics-val-row\">\n          <div class=\"metric-col-val\">\n            <span class=\"metric-label\">执念指数</span>\n            <span class=\"metric-num mono\">${obsessionVal}</span>\n          </div>\n          <div class=\"metric-col-val\">\n            <span class=\"metric-label\">实时脉搏</span>\n            <span class=\"metric-num mono\">${pulseVal}</span>\n          </div>\n        </div>\n        <div class=\"metrics-divider-line\"></div>\n        <div class=\"metrics-desc-row\">\n          <div class=\"metric-col-desc\">${obsessionDesc || '--'}</div>\n          <div class=\"metric-col-desc\">${pulseReason || '--'}</div>\n        </div>\n      </div>\n\n      <div class=\"restraint-card feather-panel\">\n        <div class=\"restraint-top\">\n          <span class=\"metric-label\">约束等级</span>\n          <span class=\"metric-num mono\" style=\"color:var(--t-scratch); font-size:13px; font-weight:800;\">${restraintPhase}</span>\n        </div>\n        ${restraintReason ? `<div class=\"restraint-desc\">${restraintReason}</div>` : ''}\n      </div>\n\n      <div class=\"san-section feather-panel\">\n        <div class=\"san-header\">\n          <span class=\"san-title-text\">SAN残存 (理智阈值)</span>\n          <span class=\"san-val-text mono\" style=\"font-weight:700;\">${san} / 100</span>\n        </div>\n        <div class=\"san-track\"><div class=\"san-bar\" style=\"width: ${san}%;\"></div></div>\n      </div>\n\n      ${symptomsHtml ? `<div class=\"symptoms-box\">${symptomsHtml}</div>` : ''}\n\n      <div class=\"log-section feather-panel\">\n        <div class=\"log-title mono\">STAFF LOG // 值班记录</div>\n        <div class=\"doctor-note\">${data.doctorNote || '无记录。'}</div>\n        ${data.scratchNote ? `<div class=\"scratch-note\">${data.scratchNote}</div>` : ''}\n      </div>\n    `;\n  }\n\n  render();\n</script>\n</body>\n</html>",
  "previewRaw": "[状态栏]\n{\n  \"fileNo\": \"CASE-0173\",\n  \"patientName\": \"{{char}}\",\n  \"threatLevel\": \"CODE RED\",\n  \"diagnosis\": \"重度妄想性依附，拒绝配合全部治疗方案\",\n  \"sanVal\": 31,\n  \"pulseVal\": \"132 BPM\",\n  \"pulseReason\": \"探视名单里出现了{{user}}的名字\",\n  \"obsessionVal\": \"99.7%\",\n  \"obsessionDesc\": \"不可控\",\n  \"restraintPhase\": \"LEVEL 3\",\n  \"restraintReason\": \"咬伤值夜护工，反复要求见{{user}}\",\n  \"symptoms\": [\n    \"在约束衣内持续摩擦手腕，皮肤已破损\",\n    \"拒绝服药，将药片藏在舌根下\",\n    \"在墙面用指甲刻写{{user}}的名字\"\n  ],\n  \"doctorNote\": \"0173号今天又闹了。第三次咬人，这周。已申请加固约束具。说什么都要见{{user}}，不给见就不吃东西。按流程上报了，等上面批。\",\n  \"scratchNote\": \"{{user}}。{{user}}。你说过会来的。你说过的。门锁了。灯一直亮着。我没有睡。我在等。你说过的。\"\n}\n[/状态栏]"
}