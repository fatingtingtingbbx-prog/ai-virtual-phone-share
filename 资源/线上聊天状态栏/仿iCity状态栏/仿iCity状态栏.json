{
  "type": "ai-phone-status-region",
  "version": 1,
  "contract": "【逻辑】你在维护{{char}}的iCity日记面板。每行一个字段，用=分隔，仅输出以下三个字段：名字、英文ID、日记内容。日记内容需符合当前剧情与{{char}}的心境。按生成的内容整块用 [状态栏]...[/状态栏] 包裹输出。\n【格式】\n[状态栏]\n名字=<角色昵称>\n英文ID=<角色英文ID或拼音，若无可用拼音>\n日记内容=<一段符合角色当前心境的日记文字，保持在同一行，如需换行使用\\n>\n[/状态栏]",
  "renderHtml": "<style>\n  :root {\n    --bg: #ffffff;\n    --top-bg: #f2f2f7;\n    --text: #1c1c1e;\n    --sub: #8e8e93;\n    --line: #e5e5ea;\n  }\n  * { box-sizing: border-box; }\n  body {\n    margin: 0;\n    font: 13px/1.5 -apple-system, \"PingFang SC\", \"Microsoft YaHei\", sans-serif;\n    color: var(--text);\n    background: transparent;\n  }\n  .card {\n    background: var(--bg);\n    border-radius: 0;\n    overflow: hidden;\n    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.15);\n    width: 100%;\n    max-width: 420px;\n    margin: 0 auto;\n  }\n  .topbar {\n    position: relative;\n    height: 44px;\n    background: var(--top-bg);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    padding: 0 12px;\n    box-shadow: 0 2px 1px rgba(0, 0, 0, 0.1); /* 更实、更清晰的阴影 */\n  }\n  .back {\n    position: absolute;\n    left: 12px;\n    top: 50%;\n    transform: translateY(-50%);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    width: 28px;\n    height: 28px;\n    padding: 0;\n    border: 0;\n    background: transparent;\n    color: var(--text);\n    cursor: pointer;\n  }\n  .back svg { width: 22px; height: 22px; }\n  .top-title { font-size: 15px; font-weight: 600; color: var(--text); }\n  .body { padding: 16px 16px 14px; }\n  .profile-row { display: flex; align-items: center; gap: 12px; }\n\n  .avatar {\n    width: 42px;\n    height: 42px;\n    border-radius: 50%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-size: 18px;\n    font-weight: 700;\n    color: #fff;\n    flex: none;\n  }\n  .profile-info { min-width: 0; }\n  .name { font-size: 15px; font-weight: 700; line-height: 1.3; }\n  .uid { font-size: 13px; color: var(--sub); margin-top: 2px; line-height: 1.4; }\n  .diary {\n    margin-top: 16px;\n    font-size: 15px;\n    line-height: 1.6;\n    color: var(--text);\n    white-space: pre-wrap;\n    word-break: break-word;\n  }\n  .time-row {\n    display: flex;\n    align-items: center;\n    gap: 6px;\n    margin-top: 12px;\n    color: var(--sub);\n    font-size: 12px;\n  }\n  .time-row svg { width: 14px; height: 14px; flex: none; }\n  .divider { height: 1px; background: var(--line); margin: 14px 0 12px; }\n\n  .actions {\n    display: flex;\n    align-items: stretch;\n    gap: 0;\n  }\n  .action,\n  .more {\n    flex: 1 1 0;\n    min-width: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    gap: 4px;\n    color: var(--sub);\n    font-size: 13px;\n    cursor: pointer;\n    white-space: normal;\n    word-break: break-word;\n    text-align: center;\n    padding: 0 8px;\n    transition: color 0.2s;\n  }\n  .action svg,\n  .more svg {\n    width: 18px;\n    height: 18px;\n    flex: none;\n    transition: fill 0.2s, stroke 0.2s;\n  }\n  .action span {\n    white-space: normal;\n    word-break: break-word;\n  }\n\n  .action:nth-child(1) { flex: 1.5 1 0; }\n  .action:nth-child(2) { flex: 1.8 1 0; }\n  .action:nth-child(3) { flex: 2.4 1 0; }\n  .more { flex: 0.6 1 0; }\n\n  .actions > * + * {\n    box-shadow: -1px 0 0 var(--line);\n  }\n\n  .more svg {\n    fill: currentColor;\n    stroke: none;\n  }\n\n  .action.liked svg {\n    fill: #ff3b30;\n    stroke: #ff3b30;\n  }\n</style>\n<div id=\"app\"></div>\n<script>\n(function () {\n  var G = [\n    [\"#f89b6c\", \"#f65e7c\"],\n    [\"#6cb6f8\", \"#5e7cf6\"],\n    [\"#8ce08a\", \"#3cb98f\"],\n    [\"#c99bf5\", \"#8a6cf6\"],\n    [\"#f8d06c\", \"#f6975e\"]\n  ];\n\n  function grad(s) {\n    var n = 0;\n    for (var i = 0; i < s.length; i++) n += s.charCodeAt(i);\n    var g = G[n % G.length];\n    return \"linear-gradient(135deg,\" + g[0] + \",\" + g[1] + \")\";\n  }\n\n  function el(tag, cls, txt) {\n    var e = document.createElement(tag);\n    if (cls) e.className = cls;\n    if (txt != null) e.textContent = txt;\n    return e;\n  }\n\n  function createSvg(inner, opts) {\n    opts = opts || {};\n    var s = document.createElementNS(\"http://www.w3.org/2000/svg\", \"svg\");\n    s.setAttribute(\"viewBox\", \"0 0 24 24\");\n    s.setAttribute(\"width\", opts.width || 18);\n    s.setAttribute(\"height\", opts.height || 18);\n    s.setAttribute(\"fill\", opts.fill || \"none\");\n    s.setAttribute(\"stroke\", opts.stroke || \"currentColor\");\n    s.setAttribute(\"stroke-width\", opts.strokeWidth || \"1.5\");\n    s.setAttribute(\"stroke-linecap\", \"round\");\n    s.setAttribute(\"stroke-linejoin\", \"round\");\n    s.innerHTML = inner;\n    return s;\n  }\n\n  function backSvg() {\n    return createSvg('<polyline points=\"15 18 9 12 15 6\"/>', { width: 22, height: 22, strokeWidth: 2 });\n  }\n\n  function clockSvg() {\n    return createSvg('<circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/>', { width: 14, height: 14 });\n  }\n\n  function heartSvg() {\n    return createSvg('<path d=\"M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z\"/>', { width: 18, height: 18 });\n  }\n\n  function bookmarkSvg() {\n    return createSvg('<path d=\"M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z\"/>', { width: 18, height: 18 });\n  }\n\n  function shareSvg() {\n    return createSvg('<path d=\"M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8\"/><polyline points=\"16 6 12 2 8 6\"/><line x1=\"12\" y1=\"2\" x2=\"12\" y2=\"15\"/>', { width: 18, height: 18 });\n  }\n\n  function moreSvg() {\n    return createSvg('<circle cx=\"5\" cy=\"12\" r=\"1.5\"/><circle cx=\"12\" cy=\"12\" r=\"1.5\"/><circle cx=\"19\" cy=\"12\" r=\"1.5\"/>', {\n      width: 18,\n      height: 18,\n      fill: \"currentColor\",\n      stroke: \"none\",\n      strokeWidth: \"0\"\n    });\n  }\n\n  function pad(n) { return n < 10 ? \"0\" + n : \"\" + n; }\n\n  function nowText() {\n    var t = new Date();\n    return t.getFullYear() + \"年\" + (t.getMonth() + 1) + \"月\" + t.getDate() + \"日 \" + pad(t.getHours()) + \":\" + pad(t.getMinutes());\n  }\n\n  function actionBtn(icon, label) {\n    var a = el(\"div\", \"action\");\n    a.appendChild(icon);\n    a.appendChild(el(\"span\", null, label));\n    if (label === \"喜欢\") {\n      a.addEventListener(\"click\", function() {\n        a.classList.toggle(\"liked\");\n      });\n    }\n    return a;\n  }\n\n  var d = {};\n  (window.STATUS_RAW || \"\").split(/\\r?\\n/).forEach(function (line) {\n    var i = line.indexOf(\"=\");\n    if (i < 1) return;\n    var k = line.slice(0, i).trim();\n    var v = line.slice(i + 1).trim();\n    d[k] = v;\n  });\n\n  var name = d[\"名字\"] || \"名字\";\n  var userId = (d[\"英文ID\"] || \"user_id\").replace(/^@/, \"\");\n  var diary = (d[\"日记内容\"] || \"今天也要加油呀。\").replace(/\\\\n/g, \"\\n\");\n\n  var app = document.getElementById(\"app\");\n  var card = el(\"div\", \"card\");\n\n  var topbar = el(\"div\", \"topbar\");\n  var backBtn = el(\"button\", \"back\");\n  backBtn.type = \"button\";\n  backBtn.setAttribute(\"aria-label\", \"返回\");\n  backBtn.appendChild(backSvg());\n  topbar.appendChild(backBtn);\n  topbar.appendChild(el(\"div\", \"top-title\", name + \" · 日记\"));\n  card.appendChild(topbar);\n\n  var body = el(\"div\", \"body\");\n  var profileRow = el(\"div\", \"profile-row\");\n  var ava = el(\"div\", \"avatar\", name.slice(0, 1));\n  ava.style.background = grad(name);\n  profileRow.appendChild(ava);\n\n  var info = el(\"div\", \"profile-info\");\n  info.appendChild(el(\"div\", \"name\", name));\n  info.appendChild(el(\"div\", \"uid\", \"@\" + userId));\n  profileRow.appendChild(info);\n  body.appendChild(profileRow);\n\n  body.appendChild(el(\"div\", \"diary\", diary));\n\n  var timeRow = el(\"div\", \"time-row\");\n  timeRow.appendChild(clockSvg());\n  timeRow.appendChild(document.createTextNode(nowText()));\n  body.appendChild(timeRow);\n\n  body.appendChild(el(\"div\", \"divider\"));\n\n  var actions = el(\"div\", \"actions\");\n  actions.appendChild(actionBtn(heartSvg(), \"喜欢\"));\n  actions.appendChild(actionBtn(bookmarkSvg(), \"小纸条\"));\n  actions.appendChild(actionBtn(shareSvg(), \"存为图片\"));\n\n  var more = el(\"div\", \"more\");\n  more.setAttribute(\"aria-label\", \"更多\");\n  more.appendChild(moreSvg());\n  actions.appendChild(more);\n\n  body.appendChild(actions);\n  card.appendChild(body);\n  app.appendChild(card);\n})();\n</script>",
  "previewRaw": "名字=林晚\n英文ID=linwan\n日记内容=That's why I'm with you. Because you say I for me."
}