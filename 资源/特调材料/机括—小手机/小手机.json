{
  "mark": "float-mixology-material",
  "version": 1,
  "material": {
    "id": "mixmat_mech_phone",
    "kind": "mechanism",
    "name": "小手机",
    "hook": "悬在画面上的一台手机：消息、联系人、朋友圈随剧情每轮更新，可拖动，也能收成一颗小把手。",
    "tags": [
      "手机",
      "消息",
      "动态",
      "常驻界面"
    ],
    "script": "// 小手机 · 钩子\n//\n// 让剧情往手机里落东西：模型在正文之外另起行写标记，出杯后由这里摘走、写进存储，\n// 正文里不留痕迹。手机上看到的每一条都是这一局真的发生过的，不是另编一套。\n//   〔讯〕会话|发信人|一句话  → 落进「会话」那个对话框；发信人是角色自己时挂在右侧\n//   〔圈〕发布人|一句话      → 落进动态\n// 一轮零到两条，剧情里没人发消息就一条都不写——手机安静也是剧情的一部分。\n\nvar MAX_THREADS = 12;    // 最多留几个人的聊天\nvar MAX_MSGS = 30;       // 每个人留几条\nvar MAX_MOMENTS = 30;    // 动态留几条\nvar MAX_LEN = 120;       // 单条长度上限\nvar DIGEST_N = 3;        // 每轮回喂给模型几条，防止它忘了自己刚发过什么\n\nvar M_MSG = \"〔讯〕\";\nvar M_MOMENT = \"〔圈〕\";\nvar M_COMMENT = \"〔评〕\";\n\nfunction tidy(value, max) {\n    var text = String(value == null ? \"\" : value).replace(/\\s+/g, \" \").trim();\n    return text.length > max ? text.slice(0, max) + \"…\" : text;\n}\n\nfunction readJson(store, key, fallback) {\n    try {\n        var raw = store && store[key];\n        if (!raw) return fallback;\n        var parsed = JSON.parse(raw);\n        return parsed == null ? fallback : parsed;\n    } catch (err) { return fallback; }\n}\n\nfunction readThreads(store) {\n    var raw = readJson(store, \"chats\", []);\n    var out = [];\n    if (!raw || typeof raw.length !== \"number\") return out;\n    for (var i = 0; i < raw.length && out.length < MAX_THREADS; i++) {\n        var item = raw[i];\n        if (!item || !item.n) continue;\n        var msgs = [];\n        var list = item.m && typeof item.m.length === \"number\" ? item.m : [];\n        for (var j = 0; j < list.length; j++) {\n            var msg = list[j];\n            if (!msg) continue;\n            var text = String(msg.x == null ? \"\" : msg.x).trim();\n            if (!text) continue;\n            msgs.push({ f: msg.f ? 1 : 0, x: text.slice(0, MAX_LEN), t: Number(msg.t) || 0 });\n        }\n        if (msgs.length > MAX_MSGS) msgs = msgs.slice(msgs.length - MAX_MSGS);\n        out.push({ n: String(item.n).slice(0, 24), m: msgs, u: Number(item.u) || 0 });\n    }\n    return out;\n}\n\nfunction readMoments(store) {\n    var raw = readJson(store, \"moments\", []);\n    var out = [];\n    if (!raw || typeof raw.length !== \"number\") return out;\n    for (var i = 0; i < raw.length; i++) {\n        var item = raw[i];\n        if (!item || !item.n) continue;\n        var text = String(item.x == null ? \"\" : item.x).trim();\n        if (!text) continue;\n        out.push({ n: String(item.n).slice(0, 24), x: text.slice(0, MAX_LEN), t: Number(item.t) || 0 });\n    }\n    if (out.length > MAX_MOMENTS) out = out.slice(out.length - MAX_MOMENTS);\n    return out;\n}\n\n/** 整行以标记开头才算，正文里顺口提到这两个字不会被误吃 */\nfunction splitMarks(text, marks) {\n    var lines = String(text == null ? \"\" : text).split(\"\\n\");\n    var kept = [];\n    var got = [];\n    for (var i = 0; i < lines.length; i++) {\n        var raw = lines[i];\n        var head = raw.replace(/^[\\s>*\\-—·　]+/, \"\");\n        var hit = \"\";\n        for (var j = 0; j < marks.length; j++) {\n            var mark = marks[j];\n            if (head.indexOf(mark) === 0) { hit = mark; break; }\n            if (head.length > 1 && \"（([【\".indexOf(head.charAt(0)) >= 0 && head.indexOf(mark) === 1) { hit = mark; break; }\n        }\n        if (!hit) { kept.push(raw); continue; }\n        var body = head.slice(head.indexOf(hit) + hit.length)\n            .replace(/^[\\s:：]+/, \"\")\n            .replace(/[）)\\]】\\s]+$/, \"\")\n            .trim();\n        if (body) got.push({ mark: hit, body: body });\n    }\n    return {\n        text: kept.join(\"\\n\").replace(/\\n{3,}/g, \"\\n\\n\").replace(/\\s+$/, \"\"),\n        got: got\n    };\n}\n\n/**\n * 「会话|发信人|内容」；只写两段时按老写法认：会话 = 发信人 = 对方。\n * 会话是\"这句话落在哪个对话框里\"，发信人是\"这句话是谁说的\"——\n * 角色回复别人时两者不同，少了前者就没法把这句话挂回原来的对话框。\n */\nfunction cut3(body, owner) {\n    var parts = body.split(/[|｜]/);\n    if (parts.length >= 3) {\n        var thread = tidy(parts[0], 24);\n        var from = tidy(parts[1], 24);\n        var text = tidy(parts.slice(2).join(\"|\"), MAX_LEN);\n        if (!thread) thread = from;\n        if (!from) from = thread;\n        return { thread: thread, from: from, x: text };\n    }\n    var two = cut2(body, owner);\n    return { thread: two.n, from: two.n, x: two.x };\n}\n\n/** 「谁|说了什么」；没写竖线就整句当内容，落到角色自己名下 */\nfunction cut2(body, fallbackName) {\n    var at = body.indexOf(\"|\");\n    if (at < 0) at = body.indexOf(\"｜\");\n    if (at < 0) return { n: fallbackName, x: tidy(body, MAX_LEN) };\n    return {\n        n: tidy(body.slice(0, at), 24) || fallbackName,\n        x: tidy(body.slice(at + 1), MAX_LEN)\n    };\n}\n\nfunction pushMsg(threads, name, text, turn, fromMe) {\n    var found = null;\n    for (var i = 0; i < threads.length; i++) if (threads[i].n === name) { found = threads[i]; break; }\n    if (!found) {\n        if (threads.length >= MAX_THREADS) threads.shift();\n        found = { n: name, m: [], u: 0 };\n        threads.push(found);\n    }\n    found.m.push({ f: fromMe ? 1 : 0, x: text, t: turn });\n    if (found.m.length > MAX_MSGS) found.m = found.m.slice(found.m.length - MAX_MSGS);\n    if (!fromMe) found.u = (found.u || 0) + 1;\n    // 有新消息的排到最前，跟真手机一样\n    var at = threads.indexOf(found);\n    if (at > 0) { threads.splice(at, 1); threads.unshift(found); }\n}\n\nfunction onSessionStart(ctx) {\n    var store = ctx.store || {};\n    if (store.chats && store.moments && store.owner === ctx.charName) return {};\n    return { store: { chats: store.chats || \"[]\", moments: store.moments || \"[]\", owner: ctx.charName || \"\" } };\n}\n\nfunction onBeforeSend(ctx) {\n    var store = ctx.store || {};\n    var threads = readThreads(store);\n    var moments = readMoments(store);\n    var charName = ctx.charName || \"角色\";\n    var userName = ctx.userName || \"玩家\";\n\n    // 回喂最近几条，模型才不会把自己刚发过的消息忘了、或者重复发一遍\n    var recent = [];\n    for (var i = 0; i < threads.length; i++) {\n        var msgs = threads[i].m;\n        for (var j = 0; j < msgs.length; j++) {\n            recent.push({ t: msgs[j].t, s: \"聊天·\" + threads[i].n + \"：\" + (msgs[j].f ? charName : threads[i].n) + \"「\" + tidy(msgs[j].x, 40) + \"」\" });\n        }\n    }\n    for (var k = 0; k < moments.length; k++) {\n        recent.push({ t: moments[k].t, s: \"动态·\" + moments[k].n + \"：\" + tidy(moments[k].x, 40) });\n    }\n    recent.sort(function (a, b) { return a.t - b.t; });\n    if (recent.length > DIGEST_N) recent = recent.slice(recent.length - DIGEST_N);\n\n    var lines = [];\n    lines.push(\"【手机 · 系统提示，不是\" + userName + \"说的话】\");\n    lines.push(\"这是\" + charName + \"的手机，\" + userName + \"能看到屏幕。\" + charName + \"和其他人在上面发消息、发动态。\");\n    if (recent.length) {\n        lines.push(\"手机上最近的几条：\");\n        for (var n = 0; n < recent.length; n++) lines.push(\"· \" + recent[n].s);\n    } else {\n        lines.push(\"手机上还是空的。\");\n    }\n    lines.push(\"——\");\n    lines.push(\"如果这一轮的剧情里有人发消息、发动态，就在正文写完后另起一行按下面的格式补上（最多两行，没人发就一行都别写）：\");\n    lines.push(M_MSG + \"会话|发信人|一句话   → 私聊消息。会话 = 落在和谁的对话框里，发信人 = 这句是谁说的\");\n    lines.push(\"　　例 \" + M_MSG + \"宋驰|宋驰|哥今天心情不对        —— 宋驰发来的\");\n    lines.push(\"　　例 \" + M_MSG + \"宋驰|\" + charName + \"|知道了        —— \" + charName + \" 回他的，落在同一个对话框里\");\n    lines.push(M_MOMENT + \"发布人|一句话      → 公开动态\");\n    lines.push(M_COMMENT + \"动态主人|评论人|内容  → 朋友圈评论 (如果是回复某人，写成：〔评〕动态主人|评论人|被回复人|内容)\");\n    lines.push(\"同一轮里一来一回就写两行，会话名保持一致。这些行不算正文，玩家在手机里看，不要在正文里再复述一遍。\");\n\n    return { note: lines.join(\"\\n\") };\n}\n\nfunction onAfterReply(ctx) {\n    var store = ctx.store || {};\n    var turn = (Number(ctx.turnCount) || 0) + 1;\n    var threads = readThreads(store);\n    var moments = readMoments(store);\n    var charName = ctx.charName || \"角色\";\n\n    var split = splitMarks(ctx.text, [M_MSG, M_MOMENT, M_COMMENT]);\n    for (var i = 0; i < split.got.length; i++) {\n        var mark = split.got[i].mark;\n        var body = split.got[i].body;\n        \n        if (mark === M_COMMENT) {\n            var parts = body.split(/\\||｜/);\n            var host = tidy(parts[0], 24);\n            if (!host) continue;\n            var cname = parts.length > 2 ? tidy(parts[1], 24) : charName;\n            var ctext = tidy(parts[parts.length - 1], MAX_LEN);\n            var toName = parts.length > 3 ? tidy(parts[2], 24) : \"\";\n            if (!ctext) continue;\n            \n            for (var m = moments.length - 1; m >= 0; m--) {\n                if (moments[m].n === host) {\n                    if (!moments[m].c) moments[m].c = [];\n                    var newC = { n: cname, x: ctext };\n                    if (toName) newC.to = toName;\n                    moments[m].c.push(newC);\n                    break;\n                }\n            }\n        } else {\n            if (mark === M_MSG) {\n                var msg = cut3(body, charName);\n                if (!msg.x) continue;\n                // 机主自己发的挂右边、不计未读；别人发的挂左边、未读 +1\n                pushMsg(threads, msg.thread, msg.x, turn, msg.from === charName);\n            } else if (mark === M_MOMENT) {\n                var one = cut2(body, charName);\n                if (!one.x) continue;\n                moments.push({ n: one.n, x: one.x, t: turn });\n            }\n        }\n    }\n    if (moments.length > MAX_MOMENTS) moments = moments.slice(moments.length - MAX_MOMENTS);\n\n    return {\n        text: split.text,\n        store: {\n            chats: JSON.stringify(threads),\n            moments: JSON.stringify(moments),\n            owner: charName\n        }\n    };\n}",
    "panelHtml": "<style>\n  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap');\n  \n  html, body { height: 100%; margin: 0; padding: 0; background: transparent; font-family: -apple-system, BlinkMacSystemFont, \"PingFang SC\", \"Helvetica Neue\", sans-serif; -webkit-font-smoothing: antialiased; overflow: hidden;}\n  \n  * { box-sizing: border-box; }\n  ::-webkit-scrollbar { width: 0px; display: none; }\n  \n  /* Hardware iPhone Casing */\n  .iphone-frame {\n    width: 100%; height: 100%;\n    background: #111111;\n    border: 12px solid #000;\n    border-radius: 48px;\n    box-shadow: inset 0 0 0 2px #444;\n    position: relative;\n    display: flex;\n    flex-direction: column;\n    overflow: hidden;\n  }\n  \n  /* Hardware Buttons */\n  .iphone-frame::before { content: ''; position: absolute; left: -14px; top: 100px; width: 2px; height: 26px; background: #333; border-radius: 2px 0 0 2px; }\n  .iphone-frame::after { content: ''; position: absolute; left: -14px; top: 140px; width: 2px; height: 50px; background: #333; border-radius: 2px 0 0 2px; box-shadow: 0 60px 0 #333; }\n  .power-btn { position: absolute; right: -14px; top: 120px; width: 2px; height: 80px; background: #333; border-radius: 0 2px 2px 0; }\n  \n  /* Dynamic Island */\n  .island {\n    position: absolute;\n    top: 8px; left: 50%;\n    transform: translateX(-50%);\n    width: 100px; height: 28px;\n    background: #000;\n    border-radius: 20px;\n    z-index: 9999;\n    box-shadow: inset 0 0 1px rgba(255,255,255,0.1);\n  }\n  \n  /* iOS Status Bar */\n  .status-bar {\n    height: 44px; flex: 0 0 auto;\n    display: flex; align-items: center; justify-content: space-between;\n    padding: 0 24px;\n    font-family: \"Inter\", -apple-system, sans-serif;\n    font-size: 13px; font-weight: 600; color: #fff;\n    position: relative; z-index: 1000;\n  }\n  .status-icons { display: flex; gap: 4px; align-items: center; letter-spacing: 1px;}\n  \n  /* WeChat App Container */\n  .wechat-app { flex: 1; min-height: 0; display: flex; flex-direction: column; position: relative; background: #111; }\n  \n  /* WeChat Header */\n  .top {\n    flex: 0 0 auto; height: 44px; display: flex; align-items: center; justify-content: space-between;\n    padding: 0 16px; position: relative; z-index: 100;\n    background: rgba(28, 28, 30, 0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);\n    border-bottom: 0.5px solid rgba(255,255,255,0.1);\n  }\n  .top b { position: absolute; left: 50%; transform: translateX(-50%); font-size: 17px; font-weight: 600; color: #fff; }\n  .back { background: transparent; border: none; color: #fff; font-size: 28px; font-weight: 300; padding: 0; cursor: pointer; display: none; margin-top: -4px;}\n  .back[data-on=\"1\"] { display: block; }\n  .more-btn { color: #fff; font-size: 20px; font-weight: bold; letter-spacing: 0px; position: absolute; right: 16px; display: flex; align-items: center; justify-content: flex-end; }\n  \n  /* Main Scrollable Body */\n  .body { flex: 1; overflow-y: auto; overflow-x: hidden; -webkit-overflow-scrolling: touch; background: #111; display: flex; flex-direction: column; position: relative; }\n  \n  /* --- Chats Tab --- */\n  .cell { display: flex; align-items: center; padding: 0 16px; height: 72px; background: #111; cursor: pointer; position: relative; }\n  .cell:active { background: #1c1c1e; }\n  .cell .ava { width: 48px; height: 48px; border-radius: 8px; flex: 0 0 auto; background: #2c2c2e; background-size: cover; background-position: center; }\n  .cell .txt { flex: 1; min-width: 0; margin-left: 12px; height: 100%; display: flex; flex-direction: column; justify-content: center; border-bottom: 0.5px solid #2a2a2c; }\n  .cell .txt-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px; }\n  .cell .txt-top em { font-style: normal; font-size: 17px; font-weight: 500; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .cell .txt-top .time { font-size: 12px; color: #555; }\n  .cell .txt span { font-size: 14px; color: #8e8e93; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n  .dot { position: absolute; left: 52px; top: 8px; min-width: 18px; height: 18px; padding: 0 5px; border-radius: 9px; background: #fa5151; color: #fff; font-size: 12px; font-weight: 500; line-height: 18px; text-align: center; border: 2px solid #111; }\n  \n  /* --- Chat View --- */\n  .chat-view { padding: 16px; display: flex; flex-direction: column; gap: 20px; }\n  .msg { display: flex; width: 100%; align-items: flex-start; gap: 12px; animation: slideUp 0.3s cubic-bezier(0.2,0.8,0.2,1); }\n  .msg[data-me=\"1\"] { flex-direction: row-reverse; }\n  @keyframes slideUp { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }\n  .msg .ava { width: 40px; height: 40px; border-radius: 4px; flex: 0 0 auto; background-size: cover; background-position: center; }\n  .msg .bubble { position: relative; max-width: 70%; padding: 10px 14px; border-radius: 8px; font-size: 16px; line-height: 1.5; word-break: break-word; }\n  .msg[data-me=\"0\"] .bubble { background: #2c2c2e; color: #fff; }\n  .msg[data-me=\"1\"] .bubble { background: #2fb855; color: #000; }\n  /* Hyper-realistic Bubble Tails using SVG backgrounds */\n  .msg[data-me=\"0\"] .bubble::before {\n    content: ''; position: absolute; top: 12px; left: -6px; width: 6px; height: 12px;\n    background: url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 6 12\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M6 0C6 0 0 3 0 6C0 9 6 12 6 12V0Z\" fill=\"%232c2c2e\"/></svg>');\n  }\n  .msg[data-me=\"1\"] .bubble::before {\n    content: ''; position: absolute; top: 12px; right: -6px; width: 6px; height: 12px;\n    background: url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 6 12\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M0 0C0 0 6 3 6 6C6 9 0 12 0 12V0Z\" fill=\"%232fb855\"/></svg>');\n  }\n  \n  /* --- Moments (朋友圈) --- */\n  .moments-view { padding-bottom: 40px; }\n  .post { display: flex; gap: 12px; padding: 16px; border-bottom: 0.5px solid #1c1c1e; }\n  .post .ava { width: 42px; height: 42px; border-radius: 6px; flex: 0 0 auto; background-size: cover; background-position: center; }\n  .post-content { flex: 1; min-width: 0; display: flex; flex-direction: column; }\n  .post-content em { font-style: normal; font-weight: 600; color: #576b95; font-size: 16px; margin-bottom: 4px; }\n  .post-content p { margin: 0 0 8px 0; line-height: 1.5; color: #fff; font-size: 15px; word-break: break-word; }\n  \n  .post-meta { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }\n  .post-meta .time { font-size: 13px; color: #8e8e93; }\n  .action-btn { width: 32px; height: 20px; background: #2c2c2e; border-radius: 4px; display: flex; align-items: center; justify-content: center; color: #576b95; font-weight: bold; font-size: 12px; }\n  \n  .comments-area { background: #1c1c1e; border-radius: 4px; padding: 6px 8px; font-size: 14px; }\n  .comments-area:empty { display: none; }\n  .likes-row { display: flex; align-items: center; gap: 6px; color: #576b95; font-weight: 600; padding-bottom: 4px; border-bottom: 0.5px solid #2a2a2c; }\n  .likes-row::before { content: '❤'; font-size: 12px; }\n  .likes-row:empty, .likes-row[data-empty=\"1\"] { display: none; border-bottom: none; }\n  \n  .comment-row { color: #fff; line-height: 1.5; margin-top: 4px;}\n  .comment-row span { color: #576b95; font-weight: 600; }\n  .reply-word { color: #fff; font-weight: normal; margin: 0 2px; }\n  \n  /* --- Bottom Nav --- */\n  .tabs { flex: 0 0 auto; height: 83px; display: flex; background: rgba(28, 28, 30, 0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-top: 0.5px solid rgba(255,255,255,0.1); padding-bottom: 34px; position: relative; z-index: 100;}\n  .tabs button { flex: 1; border: none; background: transparent; color: #8e8e93; font-size: 10px; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; padding-top: 8px; gap: 4px; }\n  .tabs button::before { content: ''; display: block; width: 26px; height: 26px; background-color: currentColor; -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center; }\n  .tabs button[data-tab=\"chats\"]::before { -webkit-mask-image: url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12 3C6.48 3 2 6.94 2 11.8c0 2.76 1.48 5.22 3.79 6.84L5 22l3.41-1.74c1.13.31 2.33.48 3.59.48 5.52 0 10-3.94 10-8.8S17.52 3 12 3z\" /></svg>'); }\n  .tabs button[data-tab=\"people\"]::before { -webkit-mask-image: url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z\" /></svg>'); }\n  .tabs button[data-tab=\"moments\"]::before { -webkit-mask-image: url('data:image/svg+xml;utf8,<svg viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><circle cx=\"12\" cy=\"12\" r=\"6\"/><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"/></svg>'); }\n  .tabs button[data-on=\"1\"] { color: #0eba0e; }\n  \n  /* Home Indicator */\n  .home-indicator { position: absolute; bottom: 8px; left: 50%; transform: translateX(-50%); width: 134px; height: 5px; background: #fff; border-radius: 100px; z-index: 1000; pointer-events: none;}\n  \n  .empty { padding: 40px; text-align: center; color: #555; font-size: 14px; line-height: 1.5; }\n    \n  /* Bottom Input Bar for Chat */\n  .send {\n    flex: 0 0 auto; display: none; align-items: center; gap: 12px;\n    padding: 10px 16px 34px 16px;\n    background: rgba(28, 28, 30, 0.85); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);\n    border-top: 0.5px solid rgba(255,255,255,0.1);\n    position: relative; z-index: 100;\n  }\n  .send[data-on=\"1\"] { display: flex; }\n  .send-input { flex: 1; height: 36px; background: #2c2c2e; border-radius: 4px; border: none; pointer-events: none; }\n\n\n  \n\n\n  /* ── 折叠成一颗小把手 ── */\n  .mini { display: none; }\n  body[data-fold=\"1\"] .iphone-frame { display: none; }\n  body[data-fold=\"1\"] .mini {\n    display: flex; align-items: center; justify-content: center; gap: 6px;\n    width: 100%; height: 100%; border-radius: 999px; cursor: pointer;\n    background: rgba(20,20,22,0.82); border: 1px solid rgba(255,255,255,0.14);\n    -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);\n    box-shadow: 0 6px 18px rgba(0,0,0,0.45); color: #fff; font-size: 12px;\n  }\n  .mini svg { width: 15px; height: 15px; }\n  .mini b { min-width: 16px; height: 16px; padding: 0 4px; border-radius: 8px; background: #fa5151; color: #fff; font-size: 10px; line-height: 16px; text-align: center; }\n  .mini b[data-on=\"0\"] { display: none; }\n  /* 状态栏兼作拖动把手 */\n  .status-bar { cursor: grab; touch-action: none; }\n  /*\n   * 收起放在底部那条 Home 指示条上：这一条本来就是空的（下面的页签已经预留了 34px），\n   * 整条都能点，命中面积够大。原来放在右上角那颗点被电池图标压住，根本看不见。\n   */\n  .fold-bar {\n    position: absolute; bottom: 0; left: 0; right: 0; height: 34px; z-index: 10000;\n    display: flex; align-items: center; justify-content: center; gap: 10px;\n    cursor: pointer; color: rgba(255,255,255,0.55);\n  }\n  .fold-bar:active { color: #fff; }\n  .fold-bar .bar { width: 110px; height: 5px; border-radius: 3px; background: currentColor; opacity: 0.75; }\n  .fold-bar svg { width: 14px; height: 14px; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; fill: none; }\n</style>\n<div class=\"mini\" id=\"mini\">\n  <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><rect x=\"6\" y=\"2\" width=\"12\" height=\"20\" rx=\"3\"/><line x1=\"10.5\" y1=\"18.5\" x2=\"13.5\" y2=\"18.5\"/></svg>\n  <b id=\"miniDot\" data-on=\"0\">0</b>\n</div>\n<div class=\"iphone-frame\">\n  <div class=\"power-btn\"></div>\n  <div class=\"island\"></div>\n  <div class=\"status-bar\">\n    <div class=\"time\" id=\"clock\">09:41</div>\n    <div class=\"status-icons\">\n       <svg width=\"18\" height=\"12\" viewBox=\"0 0 18 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M1 9.5H3V11.5H1V9.5ZM5 7.5H7V11.5H5V7.5ZM9 5.5H11V11.5H9V5.5ZM13 3.5H15V11.5H13V3.5Z\" fill=\"white\"/></svg>\n       <svg width=\"16\" height=\"12\" viewBox=\"0 0 16 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M4.5 7.5 Q8 4.5 11.5 7.5\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><path d=\"M1 4 Q8 -0.5 15 4\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\"/><circle cx=\"8\" cy=\"10.5\" r=\"1.2\" fill=\"white\"/></svg>\n       <svg width=\"24\" height=\"12\" viewBox=\"0 0 24 12\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\"><rect x=\"1\" y=\"1\" width=\"20\" height=\"10\" rx=\"3\" stroke=\"white\" stroke-width=\"1\"/><rect x=\"3\" y=\"3\" width=\"16\" height=\"6\" rx=\"1\" fill=\"white\"/><path d=\"M22 4V8C23.1046 8 24 7.10457 24 6C24 4.89543 23.1046 4 22 4Z\" fill=\"white\"/></svg>\n    </div>\n  </div>\n  <div class=\"wechat-app\">\n    <input type=\"file\" id=\"ava-upload\" style=\"display:none\" accept=\"image/*\" />\n    <div class=\"top\">\n      <button type=\"button\" class=\"back\" id=\"back\">‹</button>\n      <b id=\"title\">微信</b>\n      <div class=\"more-btn\" id=\"more-btn\"><svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"margin-top: 4px;\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line><line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line></svg></div>\n    </div>\n    <div class=\"body\" id=\"body\"></div>\n    \n    <div class=\"send\" id=\"send\">\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"1.5\"><path d=\"M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3z\"></path><path d=\"M19 10v2a7 7 0 0 1-14 0v-2\"></path><line x1=\"12\" y1=\"19\" x2=\"12\" y2=\"22\"></line></svg>\n      <div class=\"send-input\"></div>\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M8 14s1.5 2 4 2 4-2 4-2\"></path><line x1=\"9\" y1=\"9\" x2=\"9.01\" y2=\"9\" stroke-width=\"2\"></line><line x1=\"15\" y1=\"9\" x2=\"15.01\" y2=\"9\" stroke-width=\"2\"></line></svg>\n      <svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"1.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line><line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line></svg>\n    </div>\n    <div class=\"tabs\" id=\"tabs\">\n      <button type=\"button\" data-tab=\"chats\">微信</button>\n      <button type=\"button\" data-tab=\"people\">通讯录</button>\n      <button type=\"button\" data-tab=\"moments\">发现</button>\n    </div>\n  </div>\n  <div class=\"fold-bar\" id=\"fold\" title=\"收起\">\n    <span class=\"bar\"></span>\n    <svg viewBox=\"0 0 24 24\"><polyline points=\"6 9 12 15 18 9\"></polyline></svg>\n  </div>\n</div>\n<script>\n(function () {\n  \"use strict\";\n  var TITLES = { chats: \"微信\", people: \"通讯录\", moments: \"朋友圈\" };\n  var tab = \"chats\";\n  var openName = \"\";\n\n  var bodyEl = document.getElementById(\"body\");\n  var titleEl = document.getElementById(\"title\");\n  var backEl = document.getElementById(\"back\");\n  var moreBtn = document.getElementById(\"more-btn\");\n  var avaUploadEl = document.getElementById(\"ava-upload\");\n  var uploadingName = \"\";\n\n  // Dynamic Clock\n  setInterval(function(){\n      var d = new Date();\n      var h = d.getHours(), m = d.getMinutes();\n      document.getElementById(\"clock\").innerText = (h<10?'0':'')+h+\":\"+(m<10?'0':'')+m;\n  }, 1000);\n\n  function readObj(key) {\n    try { return JSON.parse((window.MIX_STORE || {})[key] || \"{}\") || {}; } catch (err) { return {}; }\n  }\n  function read(key) {\n    try { var arr = JSON.parse((window.MIX_STORE || {})[key] || \"[]\"); return arr && typeof arr.length === \"number\" ? arr : []; } catch (err) { return []; }\n  }\n  function save(patch) {\n    var store = {}; var latest = window.MIX_STORE || {};\n    for (var k in latest) store[k] = latest[k];\n    for (var p in patch) store[p] = patch[p];\n    window.MIX_STORE = store; window.mix.setStore(store);\n  }\n  function threadOf(list, name) {\n    for (var i = 0; i < list.length; i++) if (list[i].n === name) return list[i]; return null;\n  }\n  function el(tag, cls, text) {\n    var node = document.createElement(tag); if (cls) node.className = cls; if (text != null) node.textContent = text; return node;\n  }\n  function empty(text) { bodyEl.appendChild(el(\"div\", \"empty\", text)); }\n\n  function owner() { return (window.MIX_STORE || {}).owner || \"我\"; }\n\n  function createAva(name, isMe) {\n    var key = isMe ? owner() : name;\n    var avas = readObj(\"avatars\");\n    var node = el(\"div\", \"ava\");\n    if (avas[key]) {\n      node.style.backgroundImage = \"url(\" + avas[key] + \")\";\n    } else {\n      node.style.background = \"#2c2c2e\";\n      node.style.color = \"#fff\";\n      node.style.display = \"flex\"; node.style.alignItems = \"center\"; node.style.justifyContent = \"center\";\n      node.style.fontSize = \"16px\";\n      node.textContent = (key || \"?\").slice(0, 1);\n    }\n    node.onclick = function(e) {\n      e.stopPropagation(); uploadingName = key; avaUploadEl.click();\n    };\n    return node;\n  }\n\n  avaUploadEl.onchange = function(e) {\n    var file = e.target.files[0]; if (!file || !uploadingName) return;\n    var reader = new FileReader();\n    reader.onload = function(evt) {\n      var img = new Image();\n      img.onload = function() {\n        var canvas = document.createElement(\"canvas\"); var ctx = canvas.getContext(\"2d\");\n        var max = 150; var w = img.width, h = img.height;\n        if (w > h) { if (w > max) { h *= max / w; w = max; } } else { if (h > max) { w *= max / h; h = max; } }\n        canvas.width = w; canvas.height = h; ctx.drawImage(img, 0, 0, w, h);\n        var base64 = canvas.toDataURL(\"image/jpeg\", 0.8);\n        var avas = readObj(\"avatars\"); avas[uploadingName] = base64;\n        save({ avatars: JSON.stringify(avas) }); render();\n      };\n      img.src = evt.target.result;\n    };\n    reader.readAsDataURL(file); avaUploadEl.value = \"\";\n  };\n\n  function cell(name, sub, unread, onTap) {\n    var row = el(\"div\", \"cell\");\n    row.appendChild(createAva(name, false));\n    var txt = el(\"div\", \"txt\");\n    var top = el(\"div\", \"txt-top\");\n    top.appendChild(el(\"em\", null, name));\n    top.appendChild(el(\"div\", \"time\", \"星期二\")); // Fake time\n    txt.appendChild(top);\n    if (sub) txt.appendChild(el(\"span\", null, sub));\n    row.appendChild(txt);\n    if (unread) row.appendChild(el(\"div\", \"dot\", unread > 99 ? \"99+\" : String(unread)));\n    row.onclick = onTap;\n    return row;\n  }\n\n  function render() {\n    var chats = read(\"chats\"); var moments = read(\"moments\");\n    bodyEl.innerHTML = \"\";\n    backEl.setAttribute(\"data-on\", openName ? \"1\" : \"0\");\n    moreBtn.style.display = openName ? \"block\" : \"none\";\n    if (!openName) moreBtn.style.display = \"block\"; // '+' icon\n    var plusSvg = '<svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"white\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" style=\"margin-top: 4px;\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"16\"></line><line x1=\"8\" y1=\"12\" x2=\"16\" y2=\"12\"></line></svg>';\n    var dotsSvg = '<svg width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"white\" style=\"margin-top: 4px;\"><circle cx=\"5\" cy=\"12\" r=\"1.8\"/><circle cx=\"12\" cy=\"12\" r=\"1.8\"/><circle cx=\"19\" cy=\"12\" r=\"1.8\"/></svg>';\n    moreBtn.innerHTML = openName ? dotsSvg : plusSvg;\n    \n    var navTitle = openName || TITLES[tab];\n    if (!openName && tab === \"chats\" && chats.length > 0) {\n        var totalU = 0; for(var i=0; i<chats.length; i++) totalU += (chats[i].u || 0);\n        if (totalU > 0) navTitle = \"微信(\" + totalU + \")\";\n    }\n    titleEl.textContent = navTitle;\n\n    var tabs = document.getElementById(\"tabs\").children;\n    for (var i = 0; i < tabs.length; i++) tabs[i].setAttribute(\"data-on\", tabs[i].getAttribute(\"data-tab\") === tab && !openName ? \"1\" : \"0\");\n    document.getElementById(\"tabs\").style.display = openName ? \"none\" : \"flex\";\n    document.getElementById(\"send\").setAttribute(\"data-on\", openName ? \"1\" : \"0\");\n\n    if (openName) {\n      bodyEl.className = \"body chat-view\";\n      var thread = threadOf(chats, openName);\n      var msgs = thread ? thread.m || [] : [];\n      if (!msgs.length) { empty(\"还没聊过。\"); return; }\n      for (var m = 0; m < msgs.length; m++) {\n        var isMe = !!msgs[m].f;\n        var wrap = el(\"div\", \"msg\");\n        if (isMe) wrap.setAttribute(\"data-me\", \"1\");\n        else wrap.setAttribute(\"data-me\", \"0\");\n        wrap.appendChild(createAva(openName, isMe));\n        var bubble = el(\"div\", \"bubble\");\n        bubble.textContent = msgs[m].x;\n        wrap.appendChild(bubble);\n        bodyEl.appendChild(wrap);\n      }\n      setTimeout(function(){ bodyEl.scrollTop = bodyEl.scrollHeight; }, 50);\n      return;\n    }\n\n    bodyEl.className = \"body\";\n\n    if (tab === \"chats\") {\n\n      if (!chats.length) { empty(\"手机还是静的。\\n剧情里有人发消息就会落进来。\"); return; }\n      for (var c = 0; c < chats.length; c++) {\n        (function (item) {\n          var last = item.m && item.m.length ? item.m[item.m.length - 1] : null;\n          var sub = last ? (last.f ? \"\" : \"\") + last.x : \"还没聊过\";\n          bodyEl.appendChild(cell(item.n, sub, item.u || 0, function () { enter(item.n); }));\n        })(chats[c]);\n      }\n      return;\n    }\n\n    if (tab === \"people\") {\n      var names = []; var seen = {}; seen[owner()] = 1;  // 联系人里不列机主自己\n      for (var a = 0; a < chats.length; a++) if (chats[a].n && !seen[chats[a].n]) { seen[chats[a].n] = 1; names.push(chats[a].n); }\n      for (var b = 0; b < moments.length; b++) if (moments[b].n && !seen[moments[b].n]) { seen[moments[b].n] = 1; names.push(moments[b].n); }\n\n      if (!names.length) { empty(\"还没有联系人。\"); return; }\n      names.sort();\n      for (var n = 0; n < names.length; n++) {\n        (function (name) {\n          bodyEl.appendChild(cell(name, \"\", 0, function () { enter(name); }));\n        })(names[n]);\n      }\n      return;\n    }\n\n    if (tab === \"moments\") {\n        bodyEl.className = \"body moments-view\";\n        if (!moments.length) { empty(\"朋友圈还没有内容。\"); return; }\n        for (var p = moments.length - 1; p >= 0; p--) {\n            (function (item) {\n                var post = el(\"div\", \"post\");\n                post.appendChild(createAva(item.n, false));\n                var contentCol = el(\"div\", \"post-content\");\n                var who = el(\"em\", null, item.n);\n                contentCol.appendChild(who);\n                contentCol.appendChild(el(\"p\", null, item.x));\n                \n                var meta = el(\"div\", \"post-meta\");\n                meta.appendChild(el(\"div\", \"time\", \"1小时前\"));\n                meta.appendChild(el(\"div\", \"action-btn\", \"··\"));\n                contentCol.appendChild(meta);\n                \n                var likes = item.l || [];\n                var comments = item.c || [];\n                if (likes.length > 0 || comments.length > 0) {\n                    var cArea = el(\"div\", \"comments-area\");\n                    if (likes.length > 0) {\n                        var lRow = el(\"div\", \"likes-row\", \" \" + likes.join(\", \"));\n                        cArea.appendChild(lRow);\n                    }\n                    for (var i=0; i<comments.length; i++) {\n                        var cRow = el(\"div\", \"comment-row\");\n                        cRow.appendChild(el(\"span\", null, comments[i].n));\n                        if (comments[i].to) {\n                            var rw = el(\"span\", \"reply-word\", \"回复\");\n                            cRow.appendChild(rw);\n                            cRow.appendChild(el(\"span\", null, comments[i].to));\n                        }\n                        cRow.appendChild(document.createTextNode(\"：\"));\n                        cRow.appendChild(document.createTextNode(comments[i].x));\n                        cArea.appendChild(cRow);\n                    }\n                    contentCol.appendChild(cArea);\n                }\n                post.appendChild(contentCol);\n                bodyEl.appendChild(post);\n            })(moments[p]);\n        }\n    }\n  }\n\n  function toTop() { bodyEl.scrollTop = 0; }\n  function enter(name) {\n    openName = name;\n    var chats = read(\"chats\"); var thread = threadOf(chats, name);\n    if (thread && thread.u) { thread.u = 0; save({ chats: JSON.stringify(chats) }); }\n    render();\n  }\n  backEl.onclick = function () { openName = \"\"; render(); toTop(); };\n\n  var tabsEl = document.getElementById(\"tabs\");\n  for (var i = 0; i < tabsEl.children.length; i++) {\n    (function (btn) { btn.onclick = function () { tab = btn.getAttribute(\"data-tab\"); openName = \"\"; render(); toTop(); }; })(tabsEl.children[i]);\n  }\n\n  // ── 展开 / 收起 ──\n  // 展开占屏宽四分之三、屏高三分之二：对局画面约 390×780 时是 293×515，长宽比 1.76，\n  // 比上一版更接近真机的瘦长比例。往下再高就要压到输入框了（现在到屏高 75% 收住）。\n  // 只想改宽度的话，高度按 宽 × 2.34 换算（宽 75 配高 66），不然机身会拉扁或拉长。\n  var OPEN_BOX = [12, 9, 75, 66];\n  var FOLD_BOX = [84, 20, 14, 7];\n  var folded = false;\n  function applyFold() {\n    document.body.setAttribute(\"data-fold\", folded ? \"1\" : \"0\");\n    var b = folded ? FOLD_BOX : OPEN_BOX;\n    // 外壳与底板自己画（这台手机连边框都是自己的），位置大小自己定\n    window.mix.chrome(false);\n    window.mix.plate(false);\n    window.mix.drag(true);\n    // 展开时按 320 宽排版。这台手机是照 390 画的，但面板只占屏宽 3/4（约 293px），\n    // 按 390 排就得缩到 0.75 倍，17px 的会话名只剩 12.8px、页签只剩 7.5px，看不清。\n    // 按 320 排缩放是 0.92 倍，字回到 15～16px；代价是边框和灵动岛相对显得粗一点。\n    // 想要严格的 iPhone 比例就把这里改回 390，想要更大的字就往下调。\n    window.mix.design(folded ? 0 : 320);\n    window.mix.move(b[0], b[1]);\n    window.mix.size(b[2], b[3]);\n    if (folded) paintDot();\n  }\n  function paintDot() {\n    var chats = read(\"chats\"); var total = 0;\n    for (var i = 0; i < chats.length; i++) total += (chats[i].u || 0);\n    var dot = document.getElementById(\"miniDot\");\n    dot.textContent = total > 99 ? \"99+\" : String(total);\n    dot.setAttribute(\"data-on\", total ? \"1\" : \"0\");\n  }\n  document.getElementById(\"fold\").onclick = function (e) { e.stopPropagation(); folded = true; applyFold(); };\n  document.getElementById(\"mini\").onclick = function () { folded = false; applyFold(); };\n  document.querySelector(\".status-bar\").addEventListener(\"pointerdown\", function (e) { e.stopPropagation(); window.mix.grab(); });\n\n  window.onMixSync = function () { render(); if (folded) paintDot(); };\n  render();\n  applyFold();\n})();\n</script>",
